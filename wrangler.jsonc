{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker is `play` and the account's subdomain is `brain-survival`, so
  // the address reads play.brain-survival.workers.dev. The project keeps the
  // name brain-survival (package.json, the browser's storage keys).
  "name": "play",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-10",
  // Bots fill empty seats only while developing: players are offered games
  // against other people and nothing else (.claude/rules/bots.md). "false"
  // here is what the deployed Worker gets; `npm run dev` reads `.dev.vars`
  // (not committed), where ALLOW_BOTS=true turns them on for local play.
  "vars": { "ALLOW_BOTS": "false" },
  // Two more are secrets of the deployed Worker, set there with
  // `npx wrangler secret put <name>` and written nowhere in the repository:
  // RESEND_API_KEY and FEEDBACK_TO, the key and the address a player's word
  // about the game is sent on with (src/server/mail.ts). Without them the
  // game takes no feedback and its lobby offers none.
  // What the Worker and the rooms write to their log is kept, to be read in
  // the Cloudflare dashboard (Workers & Pages > play > Logs): an error in a
  // room, a limit below that could not be asked, and what a room counts of
  // itself, which is all there is to tell how the game is used
  // (src/server/room.ts): "room made: <game> listed|unlisted",
  // "game started: <game> <n> players", "game ended: <game> <n> min",
  // "host passed on: <game> the host did not answer" (everyone else was
  // ready and the host's page said nothing), "game changed: <game> to
  // <game>" (the host turned the room to another game) and
  // "room emptied: <game> listed|unlisted games <n> most <n>" (how many
  // games it saw and the most people in it at once: "games 0 most 1" is a
  // room someone waited in alone). Never a code or a name. The line Cloudflare would
  // write for every request by itself is left off: it holds the address of
  // each request, a room's code among them, and the game writes neither.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  // A limit kept by the network address a connection comes from, against a
  // script that opens connections without end: each wakes a Durable Object,
  // and the free plan has so many of those a day for the whole game. An
  // address is not a person (a household, a school, a phone network), so it
  // is set well above what a room of sixteen behind one address does: two
  // connections a player, and again when a deploy cuts everyone off.
  // Cloudflare keeps this count by each running copy of the Worker and says
  // it is not exact: a coarse guard. What has to be exact, the rooms an
  // address makes, the game counts itself (`makeLimits`,
  // src/shared/directory-config.json). `namespace_id` is any whole number
  // this account uses for nothing else.
  "ratelimits": [
    // connections to a room or to the list of rooms (src/server/index.ts)
    { "name": "CONNECT_LIMITER", "namespace_id": "52731", "simple": { "limit": 120, "period": 60 } }
  ],
  // The browser client is built by Vite; the Cloudflare Vite plugin points the
  // assets directory at that build. Room traffic must reach the Worker first.
  "assets": {
    "run_worker_first": ["/parties/*"]
  },
  // One GameRoom Durable Object per room code. The binding name is what
  // PartyServer kebab-cases into the URL: /parties/game-room/<room code>.
  // One RoomDirectory for all of them, the list of rooms anyone can join:
  // /parties/room-directory/main.
  "durable_objects": {
    "bindings": [
      { "name": "GameRoom", "class_name": "GameRoom" },
      { "name": "RoomDirectory", "class_name": "RoomDirectory" }
    ]
  },
  // SQLite storage is the only backend on the Workers Free plan, and it cannot
  // be switched on after a class has been deployed. A deployed tag is never
  // edited: a new class gets a new tag.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomDirectory"] }
  ]
}
